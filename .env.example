# 复制本文件为 .env 后填入真实值；.env 永不提交
# 说明：DASHSCOPE_API_KEY 有两种 Key，脚本会按前缀自动选择接入方式
#   ① sk-...    普通百炼按量付费 Key     → fastapi/dashscope SDK，模型见下方 A 组
#   ② sk-sp-... 百炼 Token Plan 套餐 Key  → 专用网关地址，模型见下方 B 组

DASHSCOPE_API_KEY=sk-在这里填
DEEPSEEK_API_KEY=sk-在这里填
LLM_MODEL=deepseek-chat

# ===== A 组：普通按量付费 Key（Sk- 开头）用这套 =====
# ASR_MODEL=paraformer-realtime-v2
# TTS_MODEL=cosyvoice-v2
# TTS_VOICE=longxiaochun

# ===== B 组：Token Plan 套餐 Key（sk-sp- 开头）用这套 =====
ASR_MODEL=qwen-audio-3.0-asr-flash
TTS_MODEL=qwen-audio-3.0-tts-plus
TTS_VOICE=longanhuan_v3.6

DB_PATH=data/app.db
